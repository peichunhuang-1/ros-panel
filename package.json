{
  "name": "ros-panel",
  "version": "0.1.0",
  "description": "ROS2 control panel React components — auto-discovery and prop-driven topic/service forms",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "ros-panel-server": "./bin/server.js"
  },
  "files": [
    "dist",
    "server",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "server": "node bin/server.js",
    "test": "node --test test/*.test.js",
    "test:api": "node --test test/server_api.test.js",
    "test:components": "vitest run",
    "demo": "vite --host"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "antd": ">=5",
    "@ant-design/icons": ">=5"
  },
  "dependencies": {
    "@rjsf/core": "^6.1.2",
    "@rjsf/utils": "^6.1.2",
    "@rjsf/validator-ajv8": "^6.1.2",
    "axios": "^1.13.2"
  },
  "optionalDependencies": {
    "rclnodejs": "^1.7.0",
    "express": "^5.2.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "antd": "^5.24.6",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
